# Supabase — Project Settings > API (https://supabase.com/dashboard/project/_/settings/api)

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_ prefix required: the app talks to Supabase directly from the browser.
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable" key — safe to expose client-side, access is restricted by RLS policies
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret" key — server-side only, bypasses RLS. Never expose to the browser. Not currently used by the app.
SUPABASE_SECRET_KEY=

# JWKS URL, used to verify Supabase Auth JWTs server-side. Not currently used by the app.
SUPABASE_JWKS_URL=

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
# Only used to list a playlist's videos when importing one; restrict the key to "YouTube Data API v3".
NEXT_PUBLIC_YOUTUBE_API_KEY=
